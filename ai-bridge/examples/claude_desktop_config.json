{
  "$schema": "https://claude.ai/schemas/mcp-config.json",
  "$comment": "Claude Desktop MCP 配置示例 - AI-Bridge v3.0 协议网关",
  
  "mcpServers": {
    "ai-bridge": {
      "command": "python",
      "args": ["-m", "aibridge"],
      "env": {
        "_comment": "===== 基础配置 =====",
        "AIBRIDGE_LOG_LEVEL": "INFO",
        
        "_comment_browser": "===== 浏览器配置 =====",
        "AIBRIDGE_CHROME_ENABLED": "true",
        "AIBRIDGE_CHROME_HEADLESS": "false",
        "AIBRIDGE_EDGE_ENABLED": "false",
        
        "_comment_office": "===== 办公软件 =====",
        "AIBRIDGE_OFFICE_ENABLED": "true",
        "AIBRIDGE_WORD_ENABLED": "true",
        "AIBRIDGE_EXCEL_ENABLED": "true",
        "AIBRIDGE_POWERPOINT_ENABLED": "true",
        
        "_comment_wps": "===== WPS 配置 =====",
        "AIBRIDGE_WPS_ENABLED": "false"
      }
    }
  }
}
